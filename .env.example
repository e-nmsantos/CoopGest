# CoopGest - configuracao de ambiente
# Copie este ficheiro para .env e ajuste os valores.

# Ambiente: development | production
FLASK_ENV=development

# Chave secreta Flask.
# Obrigatoria em producao. Gerar com:
# py -3.13 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=mude-esta-chave-em-producao

# Base de dados e uploads.
# Se DB_PATH ficar vazio, a app usa projetos.db na pasta do projeto
# ou junto ao executavel quando empacotada.
# DB_PATH=C:\caminho\para\projetos.db

# Admin inicial.
# Em producao, ADMIN_PASSWORD e obrigatoria quando o admin ainda nao existe.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Email opcional (Flask-Mail).
# Sem SMTP configurado, os alertas ficam apenas no log.
# Para Gmail use uma "password de aplicacao" (não a password normal).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Limites de upload/backup, em bytes.
MAX_CONTENT_LENGTH=26214400
MAX_BACKUP_FILE_BYTES=26214400
MAX_BACKUP_TOTAL_BYTES=104857600

# Desenvolvimento/utilizacao especial.
ALLOW_DEV_RESET_TOKEN=0
ENABLE_LEGACY_ROUTES=0
